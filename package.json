{
  "name": "plasmolyse-simulation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interaktive Web-Simulation zur Plasmolyse und Deplasmolyse pflanzlicher und tierischer Zellen mit Ionenpartikel-Darstellung",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
